<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for RefluxTracker (Android 12+).
   The local Room database contains personal health data and is excluded from
   both cloud backup and device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="refluxtrack_database" />
        <exclude domain="database" path="refluxtrack_database-shm" />
        <exclude domain="database" path="refluxtrack_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="refluxtrack_database" />
        <exclude domain="database" path="refluxtrack_database-shm" />
        <exclude domain="database" path="refluxtrack_database-wal" />
    </device-transfer>
</data-extraction-rules>
