<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for RefluxTracker.
   The local Room database (refluxtrack_database) contains personal health data
   (meals, reflux symptoms, notes) and is therefore excluded from Auto Backup.
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices older than API 31.
-->
<full-backup-content>
    <exclude domain="database" path="refluxtrack_database" />
    <exclude domain="database" path="refluxtrack_database-shm" />
    <exclude domain="database" path="refluxtrack_database-wal" />
</full-backup-content>
